# Set a unique secret in the hosting provider before deployment.
ADMIN_REVIEW_KEY=replace-with-a-long-random-secret

# Add your Massive Stocks API key in Vercel project environment variables.
# This key is server-side only and is never sent to the browser.
MASSIVE_API_KEY=replace-with-your-market-data-api-key

# Uncomment after you own both domains and add them to the same Vercel project.
# VITE_FRONTEND_URL=https://example.com
# VITE_ADMIN_URL=https://admin.example.com

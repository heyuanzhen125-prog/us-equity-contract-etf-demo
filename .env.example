# Set a unique secret in the hosting provider before deployment.
ADMIN_REVIEW_KEY=replace-with-a-long-random-secret

# Add your Massive Stocks API key in Vercel project environment variables.
# Only enable this after Massive has authorized public/customer-facing display
# and any use around the platform's simulated contracts for this project.
# The key is server-side only and is never sent to the browser.
MASSIVE_API_KEY=replace-with-your-market-data-api-key
MASSIVE_PUBLIC_DISPLAY_LICENSED=false

# Optional Twelve Data free Basic key for local development only.
# This adapter is intentionally disabled in production deployments.
TWELVE_DATA_API_KEY=replace-with-your-twelve-data-api-key

# Direct USDT chain monitoring framework (disabled until verification and
# durable ledger processing are implemented and explicitly enabled).
WALLET_LEDGER_DATABASE_URL=replace-with-a-pooled-postgres-connection-string
TRONGRID_API_KEY=replace-with-your-trongrid-api-key
TRON_USDT_RECEIVE_ADDRESS=
TRON_USDT_CONTRACT_ADDRESS=
ALCHEMY_API_KEY=replace-with-your-alchemy-api-key
ETH_USDT_RECEIVE_ADDRESS=
ETH_USDT_CONTRACT_ADDRESS=
POLYGON_USDT_RECEIVE_ADDRESS=
POLYGON_USDT_CONTRACT_ADDRESS=

# Uncomment after you own both domains and add them to the same Vercel project.
# VITE_FRONTEND_URL=https://example.com
# VITE_ADMIN_URL=https://admin.example.com

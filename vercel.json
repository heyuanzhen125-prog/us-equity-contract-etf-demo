{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/admin", "destination": "/" },
    { "source": "/admin/:path*", "destination": "/" }
  ],
  "functions": {
    "api/[...path].mjs": {
      "maxDuration": 30
    },
    "api/admin/[...path].mjs": {
      "maxDuration": 30
    },
    "api/time-contracts/[...path].mjs": {
      "maxDuration": 30
    },
    "api/wallet/[...path].mjs": {
      "maxDuration": 30
    }
  }
}
